[Unit]
Description=Mirte Web Interface
After=network.target
After=ssh.service
After=network-online.target

[Service]
User=mirte
# We need bash in bash since ROS noetic and NPM do not work nicely together
ExecStart=/usr/local/src/mirte/mirte-install-scripts/services/mirte_web_interface.sh
# And we need a tty to strace it
StandardInput=tty-force
TTYVHangup=yes
TTYPath=/dev/tty20
TTYReset=yes

[Install]
WantedBy=multi-user.target
