[Unit]
Description=MIRTE password change HTTP service
After=network.target

[Service]
Type=simple
User=root # locked user accounts cannot be su-ed into.
ExecStart=/usr/bin/python3 /usr/local/src/mirte/mirte-install-scripts/sites/password/change_password.py
Restart=on-failure

[Install]
WantedBy=multi-user.target